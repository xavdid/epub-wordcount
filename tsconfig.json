{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    "module": "node18",
    "target": "ES2017",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "lib": [
      // es6 defaults
      "es2017",
      "dom"
    ],
    "declaration": true
  },
  "exclude": ["__tests__", "lib"]
}
